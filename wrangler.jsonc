{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "avto2000",
	"main": "src/worker.js",
	"compatibility_date": "2026-10-01",
	"account_id": "522efa6a0dc274d95b9447f6d7c73202",
	"workers_dev": true,
	"preview_urls": false,

	// Static site exported from WordPress (npm run export). The Worker only runs
	// first for the two form endpoints; every other request is a static file.
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"html_handling": "auto-trailing-slash",
		"not_found_handling": "404-page",
		"run_worker_first": ["/wp-json/*", "/wp-admin/*"]
	},

	"vars": {
		// "log": submissions are only logged (Workers → Logs) and the form reports
		// success. Switch to "send" once a mail route below is configured.
		"MAIL_MODE": "log",
		"MAIL_FROM": "Avto 2000 <forms@avto2000.com>"
	},

	// Option 1 — Cloudflare Email Routing (needs avto2000.com on Cloudflare DNS
	// and the recipient verified under Email → Email Routing → Destinations):
	// "send_email": [{ "name": "EMAIL", "allowed_destination_addresses": ["aljaz.polh55@gmail.com"] }],
	//
	// Option 2 — Resend: `npx wrangler secret put RESEND_API_KEY`

	"observability": { "enabled": true }
}
